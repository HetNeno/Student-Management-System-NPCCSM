{
  "name": "npccsm-academic-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c red,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cd NPCCSM-PHP/public && php -d upload_max_filesize=20M -d post_max_size=25M -S 127.0.0.1:8000 ../vendor/laravel/framework/src/Illuminate/Foundation/resources/server.php",
    "dev:full": "npm run dev",
    "build": "vite build",
    "preview": "vite preview",
    "test:api": "cd NPCCSM-PHP && php vendor/bin/phpunit",
    "dev:web": "vite"
  },
  "dependencies": {
    "motion": "^13.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^8.2.2"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
